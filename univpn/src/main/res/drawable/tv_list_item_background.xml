<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: surface highlight + 2dp left accent bar + focus ring -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Background fill -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_focused" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <!-- 2dp accent bar, inset 4dp from top/bottom -->
            <item
                android:width="2dp"
                android:gravity="start"
                android:top="4dp"
                android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners
                        android:topRightRadius="2dp"
                        android:bottomRightRadius="2dp" />
                </shape>
            </item>
            <!-- Focus ring (stroke only) -->
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="@color/accent_focus" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>
