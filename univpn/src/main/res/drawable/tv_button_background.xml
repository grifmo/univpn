<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dim"/>
            <stroke android:width="1dp" android:color="@color/accent"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated"/>
            <stroke android:width="1dp" android:color="@color/accent_border"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="@color/surface_elevated"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

</selector>
