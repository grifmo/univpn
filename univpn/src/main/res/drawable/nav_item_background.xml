<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Active (selected) tab — accent-tinted bg + 2dp left accent bar -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_bg" />
                </shape>
            </item>
            <!-- 2dp accent bar, inset 4dp from top/bottom, positioned at start -->
            <item
                android:width="2dp"
                android:gravity="start"
                android:top="4dp"
                android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners
                        android:topRightRadius="2dp"
                        android:bottomRightRadius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Focused but not yet selected -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focused" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
